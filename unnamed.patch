+                file=r[1],
+                name=r[2],
+                lang=r[3],
+                symbol_kind=r[4],
+                container=r[5],
+                header=r[6],
+                body=r[7],
+                start=r[8],
+                end=r[9],
+                score=r[10],
+                rank=r[11],
+            )
+            for r in rows
+        ]
